# Supabase (côté client / frontend)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Sheets (export admin, optionnel)
VITE_GOOGLE_SHEETS_URL=

# Sentry (optionnel) — DSN de votre projet Sentry
VITE_SENTRY_DSN=

# Secrets serveur / tests (NE JAMAIS committer les vraies valeurs)
# Utilisés par : tests/*.cjs (node --env-file=.env), run-sql.cjs (hors git)
SUPABASE_SERVICE_ROLE=your-service-role-key-here
SUPABASE_MANAGEMENT_TOKEN=your-supabase-management-token-here